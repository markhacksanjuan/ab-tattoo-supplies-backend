# =============================================
# AB-Tattoo Medusa Backend - Production Environment
# =============================================
# Copy this file to .env and fill in real values before deploying.
# DO NOT commit .env with real secrets to version control!

NODE_ENV=production

# =============================================
# Database (Digital Ocean Managed PostgreSQL)
# =============================================
# Get this from DO Console > Databases > your-pg-cluster > Connection Details
DATABASE_URL=postgresql://doadmin:PASSWORD@db-postgresql-ams3-abtattoo-do-user-XXXXX.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# =============================================
# Redis (Digital Ocean Managed Redis)
# =============================================
# Get this from DO Console > Databases > your-redis-cluster > Connection Details
# Note: use rediss:// (double s) for TLS connections
REDIS_URL=rediss://default:PASSWORD@db-redis-ams3-abtattoo-do-user-XXXXX.db.ondigitalocean.com:25061

# =============================================
# Secrets (generate with: openssl rand -hex 32)
# =============================================
JWT_SECRET=
COOKIE_SECRET=

# =============================================
# Stripe (get from dashboard.stripe.com)
# =============================================
STRIPE_API_KEY=sk_live_your_real_stripe_secret_key

# =============================================
# CORS (update with your actual Vercel URL)
# =============================================
STORE_CORS=https://your-storefront.vercel.app
ADMIN_CORS=https://your-storefront.vercel.app,https://your-medusa-backend.ondigitalocean.app
AUTH_CORS=https://your-storefront.vercel.app,https://your-medusa-backend.ondigitalocean.app

# =============================================
# Backend URL (your DO App Platform URL)
# =============================================
MEDUSA_BACKEND_URL=https://your-medusa-backend.ondigitalocean.app

# =============================================
# Admin User (created on first deploy)
# =============================================
MEDUSA_ADMIN_EMAIL=admin@abtattoo.com
MEDUSA_ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# =============================================
# DO Spaces (S3-compatible file storage)
# =============================================
# Create a Space in DO Console, then generate API keys in API > Spaces Keys
S3_FILE_URL=https://your-space-name.ams3.digitaloceanspaces.com
S3_ACCESS_KEY_ID=your_spaces_access_key_id
S3_SECRET_ACCESS_KEY=your_spaces_secret_access_key
S3_REGION=ams3
S3_BUCKET=your-space-name
S3_ENDPOINT=https://ams3.digitaloceanspaces.com
S3_PREFIX=uploads
