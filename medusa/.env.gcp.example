# =============================================
# AB-Tattoo Medusa Backend - Google Cloud Production
# =============================================
# These values go into Google Cloud Secret Manager.
# Use this file as a reference — DO NOT store real secrets here.
#
# Create each secret:
#   gcloud secrets create SECRET_NAME --data-file=- <<< "value"
#
# Or from a file:
#   gcloud secrets create SECRET_NAME --data-file=secret.txt

NODE_ENV=production

# =============================================
# Database (Cloud SQL for PostgreSQL or external)
# =============================================
# If using Cloud SQL with private IP / connector:
#   DATABASE_URL=postgresql://USER:PASS@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# If using external (e.g., Supabase, Neon, etc.):
#   DATABASE_URL=postgresql://user:pass@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/tattoo_store?sslmode=require

# =============================================
# Redis (Memorystore for Redis or external)
# =============================================
# Cloud Memorystore (requires VPC connector on Cloud Run):
#   REDIS_URL=redis://MEMORYSTORE_IP:6379
# External (e.g., Upstash, Redis Cloud):
#   REDIS_URL=rediss://default:PASSWORD@host:port
REDIS_URL=redis://10.0.0.3:6379

# =============================================
# Secrets (generate with: openssl rand -hex 32)
# =============================================
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
COOKIE_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# =============================================
# Stripe
# =============================================
STRIPE_API_KEY=sk_live_your_stripe_secret_key

# =============================================
# CORS (your storefront and admin URLs)
# =============================================
STORE_CORS=https://your-storefront.vercel.app
ADMIN_CORS=https://your-storefront.vercel.app,https://abtattoo-medusa-HASH-ew.a.run.app
AUTH_CORS=https://your-storefront.vercel.app,https://abtattoo-medusa-HASH-ew.a.run.app

# =============================================
# Backend URL (your Cloud Run service URL)
# =============================================
MEDUSA_BACKEND_URL=https://abtattoo-medusa-HASH-ew.a.run.app

# =============================================
# Admin User
# =============================================
MEDUSA_ADMIN_EMAIL=admin@abtattoo.com
MEDUSA_ADMIN_PASSWORD=CHANGE_ME_strong_password

# =============================================
# File Storage (S3-compatible: GCS, DO Spaces, AWS S3)
# =============================================
# For Google Cloud Storage (use interoperability keys):
#   S3_ENDPOINT=https://storage.googleapis.com
#   S3_REGION=auto
# For DO Spaces or AWS S3, use corresponding endpoints.
S3_FILE_URL=https://storage.googleapis.com/your-bucket-name
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://storage.googleapis.com
S3_PREFIX=uploads
