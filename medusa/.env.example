NODE_ENV=development

# Database
DATABASE_URL=postgresql://medusa:medusa_dev_password@postgres:5432/medusa-db

# Redis
REDIS_URL=redis://redis:6379

# Secrets (change these in production!)
JWT_SECRET=abtattoo_jwt_secret_dev_2024
COOKIE_SECRET=abtattoo_cookie_secret_dev_2024

# Stripe (add your keys for payment processing)
