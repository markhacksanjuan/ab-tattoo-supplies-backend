# =============================================
# AB-Tattoo User API - Production Environment
# =============================================
# Copy this file to .env and fill in real values before deploying.
# DO NOT commit .env with real secrets to version control!

# =============================================
# MongoDB Atlas
# =============================================
# Get this from Atlas Console > Connect > Drivers
MONGODB_URL=mongodb+srv://abtattoo_user:PASSWORD@cluster0.xxxxx.mongodb.net/users-db?retryWrites=true&w=majority

# =============================================
# JWT Secret (generate with: openssl rand -hex 32)
# =============================================
JWT_SECRET=

# =============================================
# CORS (update with your actual Vercel URL)
# =============================================
CORS_ORIGINS=https://your-storefront.vercel.app

# =============================================
# Google OAuth (optional - for Google Sign-In)
# =============================================
# Get from console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-user-api.ondigitalocean.app/api/auth/google/callback
FRONTEND_URL=https://your-storefront.vercel.app
