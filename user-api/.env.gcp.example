# =============================================
# AB-Tattoo User API - Google Cloud Production
# =============================================
# These values go into Google Cloud Secret Manager.
# Use this file as a reference — DO NOT store real secrets here.
#
# Create each secret:
#   gcloud secrets create SECRET_NAME --data-file=- <<< "value"

# =============================================
# MongoDB (Atlas or self-hosted)
# =============================================
MONGODB_URL=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/users-db?retryWrites=true&w=majority

# =============================================
# JWT Secret (generate with: openssl rand -hex 32)
# =============================================
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# =============================================
# CORS
# =============================================
CORS_ORIGINS=https://your-storefront.vercel.app

# =============================================
# Medusa Integration
# =============================================
MEDUSA_BACKEND_URL=https://abtattoo-medusa-HASH-ew.a.run.app
MEDUSA_PUBLISHABLE_KEY=pk_your_medusa_publishable_key
MEDUSA_ADMIN_EMAIL=admin@abtattoo.com
MEDUSA_ADMIN_PASSWORD=CHANGE_ME_strong_password

# =============================================
# Google OAuth (optional)
# =============================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://abtattoo-user-api-HASH-ew.a.run.app/api/auth/google/callback
FRONTEND_URL=https://your-storefront.vercel.app
